# Postgres connection string (Neon on Vercel, or a local database)
DATABASE_URL=
# Optional: direct (unpooled) connection used for migrations
DATABASE_URL_UNPOOLED=

# Google sign-in: create an OAuth client (type "Web application") in Google Cloud Console.
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the site, e.g. https://connect.devfestilorin.com (falls back to the request's origin)
APP_URL=

# Local testing only: show a "sign in as test attendee" form under `next dev`. Ignored in production builds.
ALLOW_DEV_LOGIN=

# Google emails (comma-separated) of the people who approve organisers at /admin
ADMIN_EMAILS=

# Web Push (notifications). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
